    {
      "parameters": {
        "jsCode": "// Mesma regra de copiloto.services.metrics.check_alerts.\nconst m = $input.first().json;\nconst rules = [\n  ['custo do dia (R$)', m.cost_brl, Number($env.ALERT_MAX_DAILY_COST_BRL || 5)],\n  ['latência p95 (ms)', m.latency_p95_ms, Number($env.ALERT_MAX_P95_LATENCY_MS || 5000)],\n  ['taxa de bloqueio dos guardrails', m.guardrail_block_rate, Number($env.ALERT_MAX_GUARDRAIL_RATE || 0.2)],\n];\nconst breached = rules.filter(([, value, limit]) => value !== null && value !== undefined && value > limit);\nif (!breached.length) return [];\nconst lines = breached.map(([name, value, limit]) => `• ${name}: ${Math.round(value * 1000) / 1000} (limite ${limit})`);\nreturn [{ json: { text: `⚠️ <b>Alerta do Copiloto</b>\\n${lines.join('\\n')}` } }];"
      },
      "id": "9166d971-7259-593b-b314-4ce096a58535",
