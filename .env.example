# Copie para .env e preencha. Nunca versione o .env.

# Geral
APP_ENV=development
LOG_LEVEL=INFO
TZ=America/Recife
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Banco
# Docker: postgresql+psycopg://copiloto:copiloto@db:5432/copiloto
# Sem Docker: sqlite:///./data/processed/copiloto.db
DATABASE_URL=postgresql+psycopg://copiloto:copiloto@db:5432/copiloto

# Dados
DATA_DIR=./data
KAGGLE_CONFIG_DIR=

# LLM (endpoint compatível com OpenAI)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0
LLM_CACHE_DIR=./.llm_cache
LLM_PRICE_INPUT_USD_PER_MTOK=0
LLM_PRICE_OUTPUT_USD_PER_MTOK=0
LLM_PRICE_QUOTE_DATE=
USD_BRL=

# Reserva (Groq): LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=

# Embeddings e RAG
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=./.chroma
RAG_TOP_K=4

# Triagem
# Escolha de produção (ADR 0009): zero-shot com reserva por embeddings.
# Limiares escolhidos na validação: 0,95 (zero-shot) e 0,75 (embeddings).
TRIAGE_BACKEND=zero_shot
TRIAGE_MIN_CONFIDENCE=0.95
TRIAGE_FALLBACK=embeddings_lr
TRIAGE_FALLBACK_MIN_CONFIDENCE=0.75

# Risco e experimento
RISK_CONTACT_COST_BRL=2
RISK_NEGATIVE_REVIEW_COST_BRL=30
RISK_ASSUMED_CONTACT_EFFECT=0.2
AB_SEED=42
PROACTIVE_MAX_PER_DAY=20

# Automação e notificações
TEST_EMAIL_TO=
ALERT_MAX_DAILY_COST_BRL=5
ALERT_MAX_P95_LATENCY_MS=5000
ALERT_MAX_GUARDRAIL_RATE=0.2

# n8n (Fase 8). Estes valores não são segredos: os tokens do Telegram, do Trello, do
# e-mail e a API_KEY ficam só nas Credentials do n8n. O docker-compose repassa ao n8n
# apenas as variáveis desta seção, TEST_EMAIL_TO e os limites de alerta.
# chat_id do grupo do Telegram (número negativo, ex.: -1001234567890)
TELEGRAM_CHAT_ID=
# Código do quadro do Trello: o trecho depois de /b/ na URL (ex.: trello.com/b/AbCd1234/...)
TRELLO_BOARD_ID=
# Data simulada do primeiro lote proativo (a base é histórica); avança um dia por execução
RISK_SIM_START_DATE=2018-06-01
